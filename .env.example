OPENAI_API_KEY=

# Defaults are intentionally editable while the prototype is learning.
OPENAI_MODEL=gpt-5.2
RLR_VECTOR_STORE_ID=
RLR_VECTOR_STORE_IDS=
RLR_STATE_PATH=.rlr/vector-store.json
RLR_RETRIEVAL_MAX_RESULTS=6
RLR_MIN_RETRIEVAL_SCORE=0.25

# Local web-server defaults. Cloud hosts normally supply PORT and require
# RLR_WEB_HOST=0.0.0.0. Do not set OPENAI_API_KEY in a public repository.
RLR_WEB_PORT=3000
RLR_WEB_HOST=127.0.0.1

# Preview access. Leave RLR_AUTH_MODE=off for local development. A production
# preview defaults to password access and will refuse to start until every
# value below is configured in the host's secret manager.
RLR_AUTH_MODE=off
RLR_AUTH_SECRET=
RLR_AUTH_SECURE_COOKIES=false
# Five short-term reviewer accounts can be configured with semicolon-separated
# username|password pairs. Use passwords of at least 12 characters and do not
# include a semicolon or vertical bar in either value.
RLR_PREVIEW_ACCOUNTS=

# Preferred when the licensed corpus lives in a separate private repo.
# Separate multiple paths with semicolons on Windows.
RLR_UPLOAD_MANIFESTS=C:\Users\Scott\OneDrive\Documents\ChatGPT\rlr-ai-companion-corpus\manifests\book-openai_file_attributes.jsonl;C:\Users\Scott\OneDrive\Documents\ChatGPT\rlr-ai-companion-corpus\manifests\podcasts-openai_file_attributes.jsonl
RLR_UPLOAD_CONTENT_ROOTS=C:\Users\Scott\OneDrive\Documents\ChatGPT\rlr-ai-companion-corpus

# Optional eval/debug settings.
RLR_EVAL_RESULTS_DIR=evals/results
